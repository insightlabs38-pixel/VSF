{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!**/generated.ts",
      "!docs/deep",
      "!fixtures/golden",
      "!fixtures/recognition/snapshots",
      "!fixtures/primitives",
      "!registry",
      "!artifacts",
      "!compiler/target",
      "!compiler/target-abi-inject",
      "!test-results",
      "!playwright-report",
      "!pnpm-lock.yaml",
      "!schemas/ir/fixtures/pins.json"
    ]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": { "enabled": true, "rules": { "preset": "recommended", "style": { "noNonNullAssertion": "error" } } },
  "overrides": [
    { "includes": ["fixtures/source-apps/public/**", "fixtures/recognition/apps/**"], "linter": { "enabled": false } }
  ],
  "json": { "formatter": { "enabled": true } }
}
