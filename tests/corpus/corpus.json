    {
      "id": "filebrowser",
      "name": "File Browser",
      "upstream": "https://github.com/filebrowser/filebrowser",
      "fetch": {
        "kind": "release",
        "url": "https://github.com/filebrowser/filebrowser/releases/download/v2.63.23/linux-amd64-filebrowser.tar.gz",
        "sha256": "b14db2bb8033caa3f80205eb6578b2ed0744ebd9e716b790bc4a9703ce909e88"
      },
      "license": "Apache-2.0",
      "licenseNote": "Released binary run locally with a disposable database and sample files; the test account is created by the harness and has no other use.",
      "framework": "vue",
      "family": "filebrowser",
      "partition": "heldout",
      "privacy": "public-no-personal-data",
      "serve": {
        "kind": "process",
        "port": 0,
        "health": "/login",
        "setup": [
          ["{src}/filebrowser", "config", "init", "-d", "{work}/fb.db"],
          [
            "{src}/filebrowser",
            "users",
            "add",
            "admin",
            "admin-local-test-pass-123",
            "--perm.admin",
            "-d",
            "{work}/fb.db"
          ],
          [
            "sh",
            "-c",
            "mkdir -p {work}/root/photos {work}/root/docs && printf 'hello\\n' > {work}/root/readme.txt && printf 'id,name\\n1,a\\n' > {work}/root/data.csv && printf 'x' > {work}/root/docs/notes.md"
          ]
        ],
        "command": ["{src}/filebrowser", "-d", "{work}/fb.db", "-r", "{work}/root", "-a", "127.0.0.1", "-p", "{port}"]
      },
      "groundTruth": {
        "basis": [
          "File Browser documentation (users, sharing, uploads, downloads, commands)",
          "Chromium accessibility tree"
        ],
        "method": "annotation by a separate agent session from a dossier of the browser accessibility tree and the page description only; the annotator never saw VSF recognizer code, output or this repository's tests",
        "annotator": "separate-agent (fresh context per batch; id recorded in each annotation)"
      },
      "pages": [
        {
          "id": "login",
          "path": "/login",
          "workflows": ["sign in to the file manager"]
        },
        {
          "id": "files",
          "path": "/login",
          "workflows": ["browse files and folders", "open a folder"],
          "state": "signed in, file listing",
          "steps": [
            {
              "fill": {
                "selector": "role=textbox[name=\"Username\"]",
                "value": "admin"
              }
            },
            {
              "fill": {
                "selector": "role=textbox[name=\"Password\"]",
                "value": "admin-local-test-pass-123"
              }
            },
            {
              "click": "role=button[name=\"Login\"]",
              "waitMs": 1500
            }
          ]
        },
        {
          "id": "new-folder",
          "path": "/login",
          "workflows": ["create a folder"],
          "state": "new folder prompt opened",
          "steps": [
            {
              "fill": {
                "selector": "role=textbox[name=\"Username\"]",
                "value": "admin"
              }
            },
            {
              "fill": {
                "selector": "role=textbox[name=\"Password\"]",
                "value": "admin-local-test-pass-123"
              }
