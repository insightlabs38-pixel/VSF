{
  "schema": "vsf-corpus-v1",
  "observedAt": "2026-10-20",
  "environment": "Chromium (Playwright 1.56.1 build 1194), headless, linux x64, viewport 1280x800, en-US, UTC, reduced motion, external requests blocked except pinned npm CDN files",
  "sources": [
    {
      "id": "apg",
      "name": "W3C ARIA Authoring Practices Guide examples",
      "upstream": "https://github.com/w3c/aria-practices",
      "fetch": {
        "kind": "git",
        "url": "https://github.com/w3c/aria-practices",
        "rev": "0f765e4dc33e966026114ac12a8380db1de3b787",
        "sparse": ["content"]
      },
      "license": "W3C-Software-and-Document-License",
      "licenseNote": "Examples are published for reuse in W3C documents and implementations; read-only local evaluation.",
      "framework": "vanilla-js",
      "family": "apg",
      "partition": "dev",
      "privacy": "public-no-personal-data",
      "serve": {
        "kind": "static",
        "root": "content/"
      },
      "groundTruth": {
        "basis": [
          "APG pattern documentation: roles, states, properties and keyboard interaction tables",
          "Chromium accessibility tree"
        ],
        "method": "annotation by a separate agent session from a dossier of the browser accessibility tree and the page description only; the annotator never saw VSF recognizer code, output or this repository's tests",
        "annotator": "separate-agent (fresh context per batch; id recorded in each annotation)"
      },
      "pages": [
        {
          "id": "combobox-autocomplete-list",
          "path": "/patterns/combobox/examples/combobox-autocomplete-list.html",
          "workflows": ["choose a US state by typing into an editable combobox and picking from the suggestion list"]
        },
        {
          "id": "combobox-select-only",
          "path": "/patterns/combobox/examples/combobox-select-only.html",
          "workflows": ["choose a fruit from a select-only combobox"]
        },
        {
          "id": "combobox-datepicker",
          "path": "/patterns/combobox/examples/combobox-datepicker.html",
          "workflows": ["enter or pick a travel date through a date picker dialog"]
        },
        {
          "id": "dialog-modal",
          "path": "/patterns/dialog-modal/examples/dialog.html",
          "workflows": ["open a modal dialog to add a delivery address"],
          "state": "modal dialog opened",
          "steps": [
            {
              "click": "button:has-text('Add Delivery Address')"
            }
          ]
        },
        {
          "id": "menu-button-links",
          "path": "/patterns/menu-button/examples/menu-button-links.html",
          "workflows": ["open a menu of links from a menu button"],
          "state": "menu opened",
          "steps": [
            {
              "click": "#menubutton"
            }
          ]
        },
        {
          "id": "data-grids",
          "path": "/patterns/grid/examples/data-grids.html",
          "workflows": ["browse and sort a data grid of records", "select rows with checkboxes"]
        },
        {
          "id": "sortable-table",
          "path": "/patterns/table/examples/sortable-table.html",
          "workflows": ["sort a table of records by column"]
        },
        {
          "id": "treegrid",
          "path": "/patterns/treegrid/examples/treegrid-1.html",
          "workflows": ["expand and collapse rows of a tree grid"]
        },
        {
          "id": "listbox-scrollable",
          "path": "/patterns/listbox/examples/listbox-scrollable.html",
          "workflows": ["choose one item in a scrollable listbox"]
        },
        {
          "id": "tabs-manual",
          "path": "/patterns/tabs/examples/tabs-manual.html",
          "workflows": ["switch between tabs of content"]
        },
        {
          "id": "checkbox-mixed",
          "path": "/patterns/checkbox/examples/checkbox-mixed.html",
          "workflows": ["choose condiments with a select-all tri-state checkbox"]
        },
        {
          "id": "radio",
          "path": "/patterns/radio/examples/radio.html",
          "workflows": ["choose a pizza crust with radio buttons"]
        },
        {
          "id": "disclosure-faq",
          "path": "/patterns/disclosure/examples/disclosure-faq.html",
          "workflows": ["expand and collapse FAQ answers"]
        },
        {
          "id": "toolbar",
          "path": "/patterns/toolbar/examples/toolbar.html",
          "workflows": ["apply text formatting from a toolbar"]
        }
      ]
    },
