{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vsf-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "batch", "gate", "runs"],
  "properties": {
    "schema": { "const": "vsf-evidence-v1" },
    "batch": { "type": "string", "pattern": "^B[0-9]{2}$" },
    "gate": { "type": "string", "pattern": "^G[0-9]{1,2}$" },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "name", "command", "exit_code", "result", "log", "sha256"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^(VSF-B[0-9]{2}-T[0-9]{2}|GATE)$" },
          "name": { "type": "string", "minLength": 1 },
          "command": { "type": "string", "minLength": 1 },
          "exit_code": { "type": "integer" },
          "result": { "enum": ["PASS", "FAIL", "SKIPPED"] },
          "reason": { "type": "string" },
          "log": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
