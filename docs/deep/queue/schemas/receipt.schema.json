{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "vsf-task-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "status",
    "branch",
    "base_commit",
    "commit",
    "paths",
    "acceptance",
    "positive",
    "negative",
    "regression",
    "versions",
    "security_and_source_permissions",
    "performance_memory_storage",
    "known_limitations",
    "evidence_paths",
    "review_result"
  ],
  "properties": {
    "task_id": { "type": "string", "pattern": "^VSF-B[0-9]{2}-T[0-9]{2}$" },
    "status": { "const": "DONE" },
    "branch": { "type": "string", "minLength": 1 },
    "base_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "acceptance": { "type": "string", "minLength": 1 },
    "positive": { "$ref": "#/definitions/check" },
    "negative": { "$ref": "#/definitions/check" },
    "regression": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/regression" } },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "primitive"],
      "properties": { "schema": { "type": "string" }, "primitive": { "type": "string" } }
    },
    "security_and_source_permissions": { "type": "string", "minLength": 1 },
    "performance_memory_storage": { "type": "string", "minLength": 1 },
    "known_limitations": { "type": "array", "items": { "type": "string" } },
    "evidence_paths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^docs/deep/evidence/VSF-B[0-9]{2}/.+" }
    },
    "review_result": { "enum": ["ACCEPTED"] }
  },
  "definitions": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture", "command", "result"],
      "properties": {
        "fixture": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "result": { "const": "PASS" }
      }
    },
    "regression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "result"],
      "properties": { "command": { "type": "string", "minLength": 1 }, "result": { "const": "PASS" } }
    }
  }
}
