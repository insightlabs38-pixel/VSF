{
  "name": "@vsf/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "dependencies": {
    "@vsf/ir": "workspace:*",
    "@vsf/observer": "workspace:*",
    "@vsf/renderer": "workspace:*",
    "@vsf/schema": "workspace:*",
    "@vsf/wasm-host": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node --conditions=source build.ts",
    "test": "node --conditions=source --test --test-reporter=spec test/*.test.ts"
  },
  "exports": {
    "./build": "./build.ts",
    "./link": {
      "source": "./src/link.ts",
      "default": "./src/link.ts"
    },
    "./vault": {
      "source": "./src/vault.ts",
      "default": "./src/vault.ts"
    },
    "./kv": {
      "source": "./src/kv.ts",
      "default": "./src/kv.ts"
    }
  }
}
