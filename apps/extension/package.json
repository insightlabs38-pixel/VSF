{
  "name": "@vsf/extension",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "dependencies": {
    "@vsf/observer": "workspace:*",
    "@vsf/schema": "workspace:*",
    "@vsf/wasm-host": "workspace:*",
    "@vsf/renderer": "workspace:*"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "package": "node --conditions=source build.ts",
    "test": "node --conditions=source --test --test-reporter=spec test/*.test.ts",
    "audit": "node --conditions=source audit.ts"
  },
  "exports": {
    "./build": "./build.ts",
    "./envelope": "./src/envelope.ts",
    "./bundles": "./src/bundles.ts"
  }
}
