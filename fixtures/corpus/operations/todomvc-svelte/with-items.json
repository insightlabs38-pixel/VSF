{
  "schema": "vsf-corpus-operations-v1",
  "source": "todomvc-svelte",
  "page": "with-items",
  "dossierSha256": "1941f2df35fa6f0e8cac50f47b82589ba543250e21b3931e9596a1a75741f8fc",
  "annotator": {
    "kind": "separate-agent",
    "id": "ops-annotator-heldout-a",
    "sawRecognizerOutput": false,
    "basis": [
      "dossier todomvc-svelte/with-items.md",
      "page annotation item names",
      "TodoMVC specification behaviour"
    ]
  },
  "operations": [
    {
      "name": "Add a todo",
      "effect": "state_change",
      "steps": [
        {
          "do": "fill",
          "target": "What needs to be done?",
          "value": "Water plants"
        },
        {
          "do": "press",
          "key": "Enter"
        }
      ],
      "expect": [
        {
          "kind": "text",
          "contains": "Water plants"
        },
        {
          "kind": "text",
          "contains": "4 items left"
        }
      ]
    },
    {
      "name": "Add a todo and show active todos",
      "effect": "state_change",
      "steps": [
        {
          "do": "fill",
          "target": "What needs to be done?",
          "value": "Water plants"
        },
        {
          "do": "press",
          "key": "Enter"
        },
        {
          "do": "click",
          "target": "Active"
        }
      ],
      "expect": [
        {
          "kind": "fragment",
          "contains": "#/active"
        },
        {
          "kind": "text",
          "contains": "Water plants"
        }
      ]
    },
    {
      "name": "Show only active todos",
      "effect": "read",
      "steps": [
        {
          "do": "click",
          "target": "Active"
        }
      ],
      "expect": [
        {
          "kind": "fragment",
          "contains": "#/active"
        },
        {
          "kind": "text",
          "contains": "Walk the dog"
        }
      ]
    },
    {
      "name": "Add a todo and show completed todos",
      "effect": "state_change",
      "steps": [
        {
          "do": "fill",
          "target": "What needs to be done?",
          "value": "Water plants"
        },
        {
          "do": "press",
          "key": "Enter"
        },
        {
          "do": "click",
          "target": "Completed"
        }
      ],
      "expect": [
        {
          "kind": "fragment",
          "contains": "#/completed"
        },
        {
          "kind": "absent",
          "contains": "Water plants"
        }
      ]
    },
    {
      "name": "Complete a todo",
      "effect": "state_change",
      "steps": [
        {
          "do": "toggle",
          "target": "Buy milk",
          "checked": true
        }
      ],
      "expect": [
        {
          "kind": "checked",
          "target": "Buy milk",
          "checked": true
        },
        {
          "kind": "text",
          "contains": "2 items left"
        }
      ]
    },
    {
      "name": "Complete all todos",
      "effect": "state_change",
      "steps": [
        {
          "do": "toggle",
          "target": "\u276f Mark all as complete",
          "checked": true
        }
      ],
      "expect": [
        {
          "kind": "checked",
          "target": "Buy milk",
          "checked": true
        },
        {
          "kind": "checked",
          "target": "Walk the dog",
          "checked": true
        },
        {
          "kind": "checked",
          "target": "Read a book",
          "checked": true
        },
        {
          "kind": "text",
          "contains": "0 items left"
        }
      ]
    }
  ]
}
