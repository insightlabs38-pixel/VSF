{
  "schema": "vsf-corpus-operations-v1",
  "source": "todomvc-react",
  "page": "with-items",
  "dossierSha256": "6d0ca5e763d4494737a157eca91ffd98f2b8d5e0c855869a157d3bad851a97c5",
  "annotator": {
    "kind": "separate-agent",
    "id": "ops-annotator-heldout-a",
    "sawRecognizerOutput": false,
    "basis": [
      "dossier todomvc-react/with-items.md",
      "page annotation item names",
      "TodoMVC specification behaviour"
    ]
  },
  "operations": [
    {
      "name": "Add a todo",
      "effect": "state_change",
      "steps": [
        {
          "do": "fill",
          "target": "New Todo Input",
          "value": "Water plants"
        },
        {
          "do": "press",
          "key": "Enter"
        }
      ],
      "expect": [
        {
          "kind": "text",
          "contains": "Water plants"
        },
        {
          "kind": "text",
          "contains": "4 items left"
        }
      ]
    },
    {
      "name": "Complete all todos",
      "effect": "state_change",
      "steps": [
        {
          "do": "toggle",
          "target": "❯ Toggle All Input",
          "checked": true
        }
      ],
      "expect": [
        {
          "kind": "checked",
          "target": "❯ Toggle All Input",
          "checked": true
        },
        {
          "kind": "text",
          "contains": "0 items left"
        }
      ]
    },
    {
      "name": "Show only active todos",
      "effect": "read",
      "steps": [
        {
          "do": "click",
          "target": "Active"
        }
      ],
      "expect": [
        {
          "kind": "fragment",
          "contains": "#/active"
        },
        {
          "kind": "text",
          "contains": "Walk the dog"
        }
      ]
    },
    {
      "name": "Show completed todos after completing all",
      "effect": "read",
      "steps": [
        {
          "do": "toggle",
          "target": "❯ Toggle All Input",
          "checked": true
        },
        {
          "do": "click",
          "target": "Completed"
        }
      ],
      "expect": [
        {
          "kind": "fragment",
          "contains": "#/completed"
        },
        {
          "kind": "text",
          "contains": "Buy milk"
        }
      ]
    }
  ]
}