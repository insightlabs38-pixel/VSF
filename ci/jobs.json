{
  "jobs": {
    "hygiene": [
      {
        "name": "pnpm-install",
        "cmd": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "name": "build-native",
        "cmd": ["scripts/build-native.sh"]
      },
      {
        "name": "toolchain-pins",
        "cmd": ["node", "tools/checks/src/cli.ts", "toolchain"]
      },
      {
        "name": "generated-drift",
        "cmd": ["node", "scripts/gen-schema-constants.ts", "--check"]
      },
      {
        "name": "idl-drift",
        "cmd": ["node", "--conditions=source", "tools/idlgen/src/cli.ts", "--check"]
      },
      {
        "name": "idl-compat",
        "cmd": ["node", "--conditions=source", "tools/idlgen/src/cli.ts", "compat"]
      },
      {
        "name": "idlgen-tests",
        "cmd": ["pnpm", "--filter", "@vsf/idlgen", "run", "test"]
      },
      {
        "name": "comment-limit",
        "cmd": ["node", "tools/checks/src/cli.ts", "comments"]
      },
      {
        "name": "biome",
        "cmd": ["pnpm", "exec", "biome", "check", "."]
      },
      {
        "name": "dep-review",
        "cmd": ["node", "tools/checks/src/cli.ts", "dep-review"]
      },
      {
        "name": "vuln-scan",
        "cmd": ["node", "tools/checks/src/cli.ts", "vuln-scan"]
      },
      {
        "name": "workflow-check",
        "cmd": ["node", "tools/checks/src/cli.ts", "workflow-check"]
      },
      {
        "name": "secret-scan",
        "cmd": ["node", "tools/checks/src/cli.ts", "secrets"]
      },
      {
        "name": "catalog-check",
        "cmd": ["node", "tools/checks/src/cli.ts", "catalog", "--check"]
      },
      {
        "name": "checks-tests",
        "cmd": ["pnpm", "--filter", "@vsf/checks", "--filter", "@vsf/redact", "run", "test"]
      },
      {
        "name": "queue-validate",
        "cmd": ["node", "tools/queue/src/cli.ts", "validate"]
      },
      {
        "name": "queue-tests",
        "cmd": ["pnpm", "--filter", "@vsf/queue", "run", "test"]
      },
      {
        "name": "adversarial-b00",
        "cmd": ["pnpm", "--filter", "@vsf/adversarial-tests", "run", "test"]
      }
    ],
    "native": [
      {
        "name": "toolchain-pins",
        "cmd": ["node", "tools/checks/src/cli.ts", "toolchain"]
      },
      {
        "name": "cargo-fmt",
        "cmd": ["cargo", "fmt", "--manifest-path", "compiler/Cargo.toml", "--all", "--", "--check"]
      },
      {
        "name": "cargo-clippy",
        "cmd": [
          "cargo",
          "clippy",
          "--manifest-path",
          "compiler/Cargo.toml",
          "--locked",
          "--workspace",
          "--all-targets",
          "--",
          "-D",
          "warnings"
        ]
      },
      {
        "name": "cargo-test",
        "cmd": ["cargo", "test", "--manifest-path", "compiler/Cargo.toml", "--locked", "--workspace"]
      },
      {
        "name": "build-native",
        "cmd": ["scripts/build-native.sh"]
      },
      {
        "name": "golden-check",
        "cmd": ["node", "scripts/golden.ts", "check"]
      },
      {
        "name": "registry-check",
        "cmd": [
          "cargo",
          "run",
          "--quiet",
          "--manifest-path",
          "compiler/Cargo.toml",
          "--locked",
          "-p",
          "vsf-registry",
          "--",
          "check",
          "."
        ]
      },
      {
        "name": "dashboard-check",
        "cmd": [
          "cargo",
          "run",
          "--quiet",
          "--manifest-path",
          "compiler/Cargo.toml",
          "--locked",
          "-p",
          "vsf-registry",
          "--",
          "dashboard",
          ".",
          "--check"
        ]
      },
      {
        "name": "manifest-verify",
        "cmd": [
          "cargo",
          "run",
          "--quiet",
          "--manifest-path",
          "compiler/Cargo.toml",
          "--locked",
          "-p",
          "vsf-registry",
          "--",
          "manifest",
          "verify",
          ".",
          "--development"
        ]
      }
    ],
    "go": [
      {
        "name": "gofmt",
        "cmd": ["scripts/gofmt-check.sh"]
      },
      {
        "name": "go-vet",
        "cmd": ["go", "-C", "backend", "vet", "./..."]
      },
      {
        "name": "go-mod-verify",
        "cmd": ["go", "-C", "backend", "mod", "verify"]
      },
      {
        "name": "go-test",
        "cmd": ["go", "-C", "backend", "test", "-race", "-count=1", "./..."]
      }
    ],
    "ts": [
      {
        "name": "pnpm-install",
        "cmd": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "name": "typecheck",
        "cmd": ["pnpm", "typecheck"]
      },
      {
        "name": "build",
        "cmd": ["pnpm", "build:ts"]
      },
      {
        "name": "unit-tests",
        "cmd": [
          "pnpm",
          "--filter",
          "@vsf/schema",
          "--filter",
          "@vsf/observer",
          "--filter",
          "@vsf/ir",
          "--filter",
          "@vsf/fixture-apps",
          "--filter",
          "@vsf/extension",
          "run",
          "test"
        ]
      }
    ],
    "wasm-browser": [
      {
        "name": "pnpm-install",
        "cmd": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "name": "build-wasm",
        "cmd": ["scripts/build-wasm.sh"]
      },
      {
        "name": "build-native",
        "cmd": ["scripts/build-native.sh"]
      },
      {
        "name": "build-ts",
        "cmd": ["pnpm", "build:ts"]
      },
      {
        "name": "wasm-host-tests",
        "cmd": ["pnpm", "--filter", "@vsf/wasm-host", "run", "test"]
      },
      {
        "name": "browser-e2e",
        "cmd": ["pnpm", "--filter", "@vsf/e2e", "run", "test"]
      }
    ],
    "cross-language": [
      {
        "name": "pnpm-install",
        "cmd": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "name": "build-wasm",
        "cmd": ["scripts/build-wasm.sh"]
      },
      {
        "name": "build-native",
        "cmd": ["scripts/build-native.sh"]
      },
      {
        "name": "chain-tests",
        "cmd": ["pnpm", "--filter", "@vsf/cross-language-tests", "run", "test"]
      },
      {
        "name": "artifact-digest",
        "cmd": ["node", "tools/checks/src/cli.ts", "digest"]
      }
    ],
    "canary": [
      {
        "name": "always-passes",
        "cmd": ["node", "-e", "console.log('canary baseline ok')"]
      }
    ],
    "browser": [
      {
        "name": "pnpm-install",
        "cmd": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "name": "build-wasm",
        "cmd": ["scripts/build-wasm.sh"]
      },
      {
        "name": "build-native",
        "cmd": ["scripts/build-native.sh"]
      },
      {
        "name": "build-ts",
        "cmd": ["pnpm", "build:ts"]
      },
      {
        "name": "package-extension",
        "cmd": ["pnpm", "--filter", "@vsf/extension", "run", "package"]
      },
      {
        "name": "extension-audit",
        "cmd": ["node", "tools/checks/src/cli.ts", "ext-audit"]
      },
      {
        "name": "extension-audit-tests",
        "cmd": ["pnpm", "--filter", "@vsf/checks", "run", "test"]
      },
      {
        "name": "browser-tests",
        "cmd": ["pnpm", "--filter", "@vsf/browser-tests", "run", "test"]
      }
    ],
    "observation": [
      {
        "name": "pnpm-install",
        "cmd": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "name": "build-ts",
        "cmd": ["pnpm", "build:ts"]
      },
      {
        "name": "typecheck",
        "cmd": ["pnpm", "--filter", "@vsf/observation-tests", "run", "typecheck"]
      },
      {
        "name": "unit-tests",
        "cmd": ["pnpm", "--filter", "@vsf/observation-tests", "run", "test:unit"]
      },
      {
        "name": "recognition-snapshots",
        "cmd": ["pnpm", "--filter", "@vsf/observation-tests", "run", "check:fixtures"]
      },
      {
        "name": "browser-tests",
        "cmd": ["pnpm", "--filter", "@vsf/observation-tests", "run", "test:browser"]
      }
    ],
    "execution": [
      {
        "name": "pnpm-install",
        "cmd": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "name": "build-native",
        "cmd": ["scripts/build-native.sh"]
      },
      {
        "name": "go-vet",
        "cmd": [
          "go",
          "-C",
          "backend",
          "vet",
          "-tags",
          "integration",
          "./execution/...",
          "./versions/...",
          "./bridge/...",
          "./api/...",
          "./cli/...",
          "./interfaces/..."
        ]
      },
      {
        "name": "execution-integration",
        "cmd": [
          "go",
          "-C",
          "backend",
          "test",
          "-tags",
          "integration",
          "-race",
          "-count=1",
          "./execution/...",
          "./versions/...",
          "./bridge/...",
          "./api/...",
          "./cli/...",
          "./interfaces/..."
        ]
      }
    ],
    "ui": [
      {
        "name": "pnpm-install",
        "cmd": ["pnpm", "install", "--frozen-lockfile"]
      },
      {
        "name": "build-ts",
        "cmd": ["pnpm", "build:ts"]
      },
      {
        "name": "typecheck",
        "cmd": ["pnpm", "--filter", "@vsf/ui-tests", "run", "typecheck"]
      },
      {
        "name": "unit-tests",
        "cmd": ["pnpm", "--filter", "@vsf/ui-tests", "run", "test:unit"]
      },
      {
        "name": "browser-tests",
        "cmd": ["pnpm", "--filter", "@vsf/ui-tests", "run", "test:browser"]
      }
    ]
  }
}
